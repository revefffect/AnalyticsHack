{$METEO_SITE_ADDRESS} {
    request_body {
        max_size 12MB
    }
    handle /internal/* {
        respond 404
    }
    handle_path /grafana/* {
        route {
            request_header -X-WEBAUTH-USER
            forward_auth app:8000 {
                uri /internal/grafana-auth/
                header_up X-Meteo-Proxy-Key {$METEO_GRAFANA_PROXY_KEY}
                copy_headers X-WEBAUTH-USER
            }
            reverse_proxy grafana:3000 {
                header_up -Authorization
                header_down Cache-Control "private, no-store"
            }
        }
    }
    handle {
        reverse_proxy app:8000
    }
}
